                <div class="social-icons-img">
                    <a href="#"><img src="https://via.placeholder.com/35/ffffff/000000?text=f" alt="Facebook"></a>
                    <a href="#"><img src="https://via.placeholder.com/35/ffffff/000000?text=YT" alt="YouTube"></a>
                    <a href="#"><img src="https://via.placeholder.com/35/ffffff/000000?text=IG" alt="Instagram"></a>
                    <a href="#"><img src="https://via.placeholder.com/35/ffffff/000000?text=WA" alt="Viber"></a>
                </div>
                <div class="google-play-badge">
