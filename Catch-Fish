<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catch-Fish — Головна</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Шапка сайту -->
    <header class="header">
        <div class="top-bar" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 20px; background: #1b4332; flex-wrap: wrap;">
            <!-- Логотип зліва -->
            <div class="logo">
                <a href="index.html">
                   <img src="images/Gemini_Generated_Image_hhkrofhhkrofhhkr.jpg" alt="Catch-Fish Logo" style="width: 160px; height: 80px; object-fit: contain; border-radius: 4px; display: block;">
                </a>
            </div>
            
            <a href="index.html" class="site-title-link" style="text-decoration: none;">
                <span class="site-title" style="color: #fff; font-size: 26px; font-weight: bold;">Catch-Fish</span>
            </a>

            <!-- Навігація справа з іконками -->
            <nav class="user-nav" style="display: flex; gap: 15px; align-items: center;">
                <a href="account.html" class="nav-item" style="color: #fff; text-decoration: none; display: flex; align-items: center; gap: 4px; font-size: 13px;">
                    <span>👤</span> Кабінет
                </a>
                <a href="wishlist.html" class="nav-item" style="color: #fff; text-decoration: none; display: flex; align-items: center; gap: 4px; font-size: 13px;">
                    <span>❤️</span> Обране
                </a>
                <a href="index.html" class="nav-item" style="color: #fff; text-decoration: none; display: flex; align-items: center; gap: 4px; font-size: 13px;">
                    <span>🚪</span> Вихід
                </a>
            </nav>
        </div>

        <!-- Головне меню (вирівняне та структуроване в одну лінію) -->
        <nav class="main-nav" style="background: #143627; padding: 10px 20px;">
            <ul style="list-style: none; display: flex; flex-wrap: wrap; gap: 20px; margin: 0; padding: 0; justify-content: center; align-items: center;">
                <li><a href="catalog.html" style="color: #fff; text-decoration: none; font-weight: bold; font-size: 14px;">Рибальство</a></li>
                <li><a href="catalog.html" style="color: #fff; text-decoration: none; font-weight: bold; font-size: 14px;">Приманка</a></li>
                <li><a href="catalog2.html" style="color: #fff; text-decoration: none; font-weight: bold; font-size: 14px;">Гачки</a></li>
                <li><a href="catalog3.html" style="color: #fff; text-decoration: none; font-weight: bold; font-size: 14px;">Волосіння</a></li>
                <li><a href="catalog4.html" style="color: #fff; text-decoration: none; font-weight: bold; font-size: 14px;">Готові набори</a></li>
            </ul>
        </nav>
    </header>

    <!-- Основний контент -->
    <main class="main-content">

        <!-- Секція категорій (Усі 4 категорії рівно в один ряд) -->
        <section class="categories-section" style="padding: 20px 10px;">
            <div class="categories-container" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-width: 100%; overflow-x: auto;">
                
                <a href="catalog2.html" class="category-card category-card-link" style="text-align: center; text-decoration: none; color: #000; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff;">
                   <img src="images/images (16).jpg" alt="Гачки" class="cat-icon" style="width: 50px; height: 50px; object-fit: contain; display: block; margin: 0 auto 5px auto;">
                   <span style="font-size: 12px; font-weight: bold;">Гачки</span>
                </a>

                <a href="catalog.html" class="category-card category-card-link" style="text-align: center; text-decoration: none; color: #000; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff;">
                   <img src="images/images (14).jpg" alt="Прикормки" class="cat-icon" style="width: 50px; height: 50px; object-fit: contain; display: block; margin: 0 auto 5px auto;">
                   <span style="font-size: 12px; font-weight: bold;">Прикормки</span>
                </a>

                <a href="catalog4.html" class="category-card category-card-link" style="text-align: center; text-decoration: none; color: #000; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff;">
                    <img src="images/images (12).jpg" alt="Готові набори" class="cat-icon" style="width: 50px; height: 50px; object-fit: contain; display: block; margin: 0 auto 5px auto;">
                    <span style="font-size: 12px; font-weight: bold;">Набори</span>
                </a>

                <a href="catalog3.html" class="category-card category-card-link" style="text-align: center; text-decoration: none; color: #000; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff;">
                    <img src="images/images (15).jpg" alt="Волосіння" class="cat-icon" style="width: 50px; height: 50px; object-fit: contain; display: block; margin: 0 auto 5px auto;">
                    <span style="font-size: 12px; font-weight: bold;">Волосіння</span>
                </a>

            </div>
        </section>
        

        <!-- Блок популярних брендів -->
        <section class="brands-section">
            <div class="brands-container">
                <div class="brand-box brand-title-box">Популярні бренди</div>
                <div class="brand-box brand-blue">Shimano</div>
                <div class="brand-box brand-red">Flagman</div>
                <div class="brand-box brand-green">Rapala</div>
                <div class="brand-box brand-dark">Braring</div>
            </div>
        </section>

        <!-- Секція Розпродаж (Слайд 1) -->
        <section class="sale-section">
            <div class="sale-header">
                <h2 class="sale-title">Розпродаж</h2>
                <span class="tag-orange">Рибальство</span>
                <span class="tag-orange">-50% На все</span>
            </div>

            <div class="products-grid-wrapper">
                <div class="products-grid">
                    <div class="product-card">
                        <span class="badge-sale">SALE</span>
                        <img src="images/images (18).jpg" alt="Блешня" style="align-self: center; margin-top: 10px; width: 150px; height: 150px; object-fit: contain;">
                        <h3>Блешня Lucky John Spin X</h3>
                        <div class="old-price">150 грн</div>
                        <div class="price">100 грн</div>
                    </div>

                    <div class="product-card">
                        <span class="badge-sale">SALE</span>
                        <img src="images/images (19).jpg" alt="Блешня" style="align-self: center; margin-top: 10px; width: 150px; height: 150px; object-fit: contain;">
                        <h3>Блешня Lucky John Spin X</h3>
                        <div class="old-price">100 грн</div>
                        <div class="price">50 грн</div>
                    </div>

                    <div class="product-card">
                        <span class="badge-sale">SALE</span>
                       <img src="images/ggg.webp" alt="Набір" style="align-self: center; margin-top: 10px; width: 150px; height: 150px; object-fit: contain;">
                        <h3>Готовий НАБІР ДЛЯ РИБАКА</h3>
                        <div class="old-price">400 грн</div>
                        <div class="price">250 грн</div>
                    </div>

                    <div class="product-card">
                        <span class="badge-sale">SALE</span>
                        <img src="images/images (20).jpg" alt="Набір" style="align-self: center; margin-top: 10px; width: 150px; height: 150px; object-fit: contain;">
                        <h3>Бойли Crazy Carp Silver</h3>
                        <div class="old-price">120 грн</div>
                        <div class="price">100 грн</div>
                    </div>
                </div>

                <!-- Перехід на 2-й слайд -->
                <a href="index-page2.html" class="next-slide-btn" title="Наступна сторінка">›</a>
            </div>
        </section>

    </main>

